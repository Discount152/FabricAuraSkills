{
  "schemaVersion": 1,
  "id": "auraskills",
  "version": "${version}",
  "name": "Granite Skills",
  "description": "Granite Skills — dedicated server skills for Minecraft 26.3. Mod id stays auraskills so existing configs and Granitelib keep resolving. See fabric/FABRIC_QUICKSTART.md.",
  "authors": ["Archyx (original)", "Fabric port"],
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "server": [
      "dev.aurelium.auraskills.fabric.FabricAuraSkillsMod"
    ]
  },
  "mixins": [
    "auraskills.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-permissions-api-v0": "*"
  }
}
