{
  "schemaVersion": 1,
  "id": "auraskills",
  "version": "${version}",
  "name": "FabricAuraSkills",
  "description": "Fabric dedicated-server port of AuraSkills for Minecraft 1.21.11 (skills, XP, storage, permissions). Requires the GraniteLib Fabric mod (granitelib) for menu/layout primitives. See README and fabric/PARITY_COMPLETION_ROADMAP.md.",
  "authors": ["Archyx (original AuraSkills)", "Discount152 (Fabric port)"],
  "contact": {
    "homepage": "https://github.com/Discount152/FabricAuraSkills",
    "sources": "https://github.com/Discount152/FabricAuraSkills",
    "issues": "https://github.com/Discount152/FabricAuraSkills/issues"
  },
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "server": [
      "dev.aurelium.auraskills.fabric.FabricAuraSkillsMod"
    ]
  },
  "mixins": [
    "auraskills.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-permissions-api-v0": "*",
    "granitelib": ">=0.1.0-alpha.2"
  }
}
